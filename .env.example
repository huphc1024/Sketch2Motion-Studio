# Sketch2Motion backend configuration
SKETCH2MOTION_HOST=127.0.0.1
SKETCH2MOTION_PORT=7880
SKETCH2MOTION_TTS_CONCURRENCY=1

# Local VieNeu audio bridge. The bridge must expose GET /voices and
# POST /synthesize, returning WAV/MP3 bytes or JSON with audioUrl/base64 audio.
VIENEU_TTS_URL=http://127.0.0.1:8001
VIENEU_TTS_VOICES_PATH=/voices
VIENEU_TTS_SYNTHESIZE_PATH=/synthesize
VIENEU_TTS_TIMEOUT=180

# Optional settings used by `python -m services.tts.vieneu_bridge`.
VIENEU_BRIDGE_HOST=127.0.0.1
VIENEU_BRIDGE_PORT=8001
VIENEU_MODE=v3turbo
VIENEU_DEVICE=cpu
VIENEU_BACKEND=auto
VIENEU_PRECISION=int8
# VIENEU_THREADS=8
# VIENEU_MODEL=pnnbao-ump/VieNeu-TTS-v3-Turbo
# VIENEU_MODE=remote
# VIENEU_REMOTE_API_BASE=http://127.0.0.1:23333/v1

# Optional offline voice list when the bridge has no /voices endpoint.
# VIENEU_TTS_VOICES=[{"id":"My custom voice","name":"My custom voice"}]
